# ── Required (server refuses to start without these) ─────────────────────────
# Rotated MongoDB Atlas connection string (NEVER commit a real one)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Long random secret used to sign user JWTs
JWT_SECRET=change_me_to_a_long_random_string

# Admin dashboard access password (sent via x-admin-pass header)
ADMIN_PASSWORD=your_secure_admin_password_here

# Key used to encrypt chat messages at rest (AES-256-CBC)
ENCRYPTION_KEY=change_me_to_a_long_random_string

# Key used to encrypt stored emails at rest (kept separate from ENCRYPTION_KEY)
EMAIL_ENCRYPTION_KEY=change_me_to_another_random_string

# ── Frontend / OAuth ─────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173,https://your-frontend.example.com

# Google OAuth client ID (public identifier)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Optional integrations ────────────────────────────────────────────────────
# Upstash/Redis URL for the socket.io adapter + matchmaking queue.
# If omitted the server runs with an in-memory queue (single instance only).
# REDIS_URL=rediss://:<token>@<host>:6379

# Web push (VAPID). If omitted, push notifications are disabled.
# VAPID_SUBJECT=mailto:admin@twelo.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Cloudinary media storage
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Groq (AI companion). Optional.
# GROQ_API_KEY=

# Sightengine nudity check (image uploads). Optional.
# SIGHTENGINE_USER=
# SIGHTENGINE_API_SECRET=

# ── Operational flags ────────────────────────────────────────────────────────
# Set to "true" ONE TIME to backfill existing plaintext emails to encrypted form,
# then set it back to false/omit. Left off by default.
# RUN_EMAIL_MIGRATION=false
